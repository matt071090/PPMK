[
  { "id": "company-details", "tier": "A", "kind": "setting", "title": "Company Details & Branch", "doc": "company-details", "ref": "1.1",
    "note": "Nama, alamat, NPWP perusahaan, dan branch. Branch wajib ada sebelum Warehouse dan Business Partner." },
  { "id": "general-settings", "tier": "A", "kind": "setting", "title": "General Settings", "doc": "general-settings", "ref": "1.2",
    "note": "Termasuk Set Inventory Method By, yang menentukan akun persediaan diambil dari item group atau warehouse." },
  { "id": "document-settings", "tier": "A", "kind": "setting", "title": "Document Settings", "doc": "document-settings", "ref": "1.3" },
  { "id": "users", "tier": "A", "kind": "setting", "title": "User & Authorization", "doc": "users", "ref": "1.6 · 1.7", "template": "T23",
    "note": "Dibuat lewat template Excel T23 (Service Layer Users: user, branch, authorization group, izin per menu). Password tidak bisa dibaca dari DB sumber, jadi tidak dibandingkan di sini." },

  { "id": "currencies", "tier": "B", "kind": "data", "title": "Currencies", "doc": "currencies", "ref": "2.4", "upload": false,
    "match": ["Code"], "required": ["Code", "Name"], "note": "Bandingkan & export saja; upload menyusul setelah field Service Layer Currencies dicocokkan." },
  { "id": "uom", "tier": "B", "kind": "data", "title": "Units of Measure", "doc": "uom", "ref": "–", "template": "T07",
    "entity": "UnitOfMeasurements", "keyField": "AbsEntry", "match": ["Code"], "required": ["Code", "Name"] },
  { "id": "uom-groups", "tier": "B", "kind": "data", "title": "UoM Groups", "doc": "uom-groups", "ref": "–", "template": "T08", "upload": false,
    "match": ["Code"], "required": ["Code", "Name"], "requires": ["Units of Measure"],
    "note": "Bandingkan & export saja; base UoM dan baris konversi memakai nomor entry, upload menyusul." },
  { "id": "price-lists", "tier": "B", "kind": "data", "title": "Price List", "doc": "price-lists", "ref": "3.5", "template": "T04",
    "entity": "PriceLists", "keyField": "PriceListNo", "match": ["PriceListName"], "required": ["PriceListName"], "numeric": ["Factor"],
    "lookups": [{ "field": "BasePriceList", "from": "_BasePriceList", "step": "price-lists", "by": "PriceListName" }] },
  { "id": "payment-terms", "tier": "B", "kind": "data", "title": "Payment Terms", "doc": "payment-terms", "ref": "2.10", "template": "T03",
    "entity": "PaymentTermsTypes", "keyField": "GroupNumber", "match": ["PaymentTermsGroupName"], "required": ["PaymentTermsGroupName"],
    "numeric": ["NumberOfAdditionalMonths", "NumberOfAdditionalDays", "NumberOfToleranceDays", "CreditLimit"], "requires": ["Price List"] },
  { "id": "sales-employees", "tier": "B", "kind": "data", "title": "Sales Employee / Buyer", "doc": "sales-employee", "ref": "1.5", "template": "T16",
    "entity": "SalesPersons", "keyField": "SalesEmployeeCode", "match": ["SalesEmployeeName"], "required": ["SalesEmployeeName"],
    "numeric": ["CommissionForSalesEmployee"] },
  { "id": "employees", "tier": "B", "kind": "data", "title": "Employee", "doc": "sales-employee", "ref": "1.5",
    "entity": "EmployeesInfo", "keyField": "EmployeeID", "match": ["FirstName", "LastName"], "required": ["FirstName"],
    "note": "Belum ada template Excel; mapping field EmployeesInfo perlu direview." },
  { "id": "shipping-types", "tier": "B", "kind": "data", "title": "Shipping Type", "doc": "business-partners", "ref": "3.4", "template": "T19",
    "entity": "ShippingTypes", "keyField": "Code", "match": ["Name"], "required": ["Name"] },
  { "id": "bp-groups", "tier": "B", "kind": "data", "title": "Business Partner Group", "doc": "business-partners", "ref": "3.4", "template": "T10",
    "entity": "BusinessPartnerGroups", "keyField": "Code", "match": ["Name", "Type"], "required": ["Name", "Type"] },
  { "id": "cost-centers", "tier": "B", "kind": "data", "title": "Profit Center / Cost Center", "doc": "cost-center", "ref": "2.9", "template": "T02",
    "entity": "ProfitCenters", "keyField": "CenterCode", "keyString": true, "match": ["CenterCode"],
    "required": ["CenterCode", "CenterName", "InWhichDimension", "EffectiveFrom"], "numeric": ["InWhichDimension"] },
  { "id": "banks", "tier": "B", "kind": "data", "title": "Bank", "doc": "banks", "ref": "2.5", "template": "T17",
    "entity": "Banks", "keyField": "AbsoluteEntry", "match": ["BankCode", "CountryCode"], "required": ["BankCode", "BankName", "CountryCode"] },

  { "id": "coa", "tier": "C", "kind": "data", "title": "Chart of Accounts", "doc": "coa", "ref": "2.1", "template": "T12",
    "entity": "ChartOfAccounts", "keyField": "Code", "keyString": true, "match": ["Code"], "required": ["Code", "Name"], "requires": ["Currencies"],
    "info": ["_Level"], "parent": { "field": "FatherAccountKey", "key": "Code", "level": "_Level", "title": ["ActiveAccount", "tNO"] },
    "uploadSort": ["ActiveAccount", "_Level", "Code"],
    "note": "Upload naik per level: semua akun judul dari level terendah dulu, baru akun aktif. Akun induk (FatherAccountKey) harus ada di tujuan atau ikut di-upload." },

  { "id": "posting-periods", "tier": "D", "kind": "data", "title": "Posting Period", "doc": "posting-period", "ref": "2.12", "template": "T01", "upload": false,
    "match": ["Code"], "required": ["Code"], "requires": ["Chart of Accounts"],
    "note": "Bandingkan & export saja; periode dibuat lewat CompanyService_CreatePeriodWithFinanceParams (template T01), upload menyusul." },
  { "id": "tax-groups", "tier": "D", "kind": "data", "title": "Tax Group", "doc": "tax", "ref": "2.3", "template": "T13",
    "entity": "VatGroups", "keyField": "Code", "keyString": true, "match": ["Code"], "required": ["Code", "Name", "Category"], "numeric": ["Rate"],
    "accounts": ["TaxAccount"], "requires": ["Chart of Accounts"] },
  { "id": "withholding-tax", "tier": "D", "kind": "data", "title": "Withholding Tax", "doc": "tax", "ref": "2.3", "upload": false,
    "match": ["Code"], "required": ["Code", "Name"], "requires": ["Chart of Accounts"],
    "note": "Bandingkan & export saja; upload menyusul setelah field Service Layer WithholdingTaxCodes dicocokkan." },
  { "id": "gl-determination", "tier": "D", "kind": "setting", "title": "G/L Account Determination", "doc": "gl-determination", "ref": "2.2",
    "note": "Akun default disimpan per posting period (PeriodCategory), jadi dicek manual per tab di halaman dokumentasinya. Upload menyusul." },
  { "id": "house-banks", "tier": "D", "kind": "data", "title": "House Banks", "doc": "house-bank", "ref": "2.6", "template": "T18",
    "entity": "HouseBankAccounts", "keyField": "AbsoluteEntry", "match": ["BankCode", "AccNo"], "required": ["BankCode", "Country", "AccNo", "GLAccount"],
    "accounts": ["GLAccount"], "requires": ["Bank", "Chart of Accounts"] },
  { "id": "payment-methods", "tier": "D", "kind": "data", "title": "Payment Methods", "doc": "payment-methods", "ref": "2.11", "upload": false,
    "match": ["Code"], "required": ["Code"], "requires": ["House Banks"],
    "note": "Bandingkan & export saja; upload menyusul setelah field Service Layer WizardPaymentMethods dicocokkan." },
  { "id": "freight", "tier": "D", "kind": "data", "title": "Freight", "doc": "freight", "ref": "2.7", "template": "T20",
    "entity": "AdditionalExpenses", "keyField": "ExpensCode", "match": ["Name"], "required": ["Name", "RevenuesAccount", "ExpenseAccount"],
    "accounts": ["RevenuesAccount", "ExpenseAccount"], "requires": ["Chart of Accounts", "Tax Group"] },
  { "id": "landed-costs", "tier": "D", "kind": "data", "title": "Landed Cost", "doc": "landed-cost", "ref": "2.8", "template": "T21",
    "entity": "LandedCostsCodes", "keyField": "Code", "keyString": true, "match": ["Code"], "required": ["Code", "Name", "LandedCostsAllocationAccount"],
    "accounts": ["LandedCostsAllocationAccount"], "requires": ["Chart of Accounts"],
    "note": "AllocationBy belum ikut di-upload: kode OALC.OhType belum dicocokkan ke enum Service Layer." },
  { "id": "item-groups", "tier": "D", "kind": "data", "title": "Item Group", "doc": "item-groups", "ref": "3.1", "template": "T05",
    "entity": "ItemGroups", "keyField": "Number", "match": ["GroupName"], "required": ["GroupName"], "requires": ["Chart of Accounts"],
    "accounts": ["InventoryAccount", "CostAccount", "RevenuesAccount", "ReturningAccount", "ExpensesAccount", "TransfersAccount", "VarianceAccount",
      "PriceDifferencesAccount", "DecreasingAccount", "IncreasingAccount", "StockInTransitAccount", "WIPMaterialAccount"] },
  { "id": "warehouses", "tier": "D", "kind": "data", "title": "Warehouse", "doc": "warehouses", "ref": "3.3", "template": "T09",
    "entity": "Warehouses", "keyField": "WarehouseCode", "keyString": true, "match": ["WarehouseCode"],
    "required": ["WarehouseCode", "WarehouseName", "_Branch"], "requires": ["Branch", "Chart of Accounts"],
    "lookups": [{ "field": "BusinessPlaceID", "from": "_Branch", "step": "branches", "by": "Name" }],
    "note": "Akun tab Accounting warehouse belum ikut di-upload. Branch dicocokkan lewat nama." },
  { "id": "fa-account-determination", "tier": "D", "kind": "data", "title": "FA Account Determination", "doc": "gl-determination", "ref": "2.2", "template": "T14",
    "entity": "FAAccountDeterminations", "keyField": "Code", "keyString": true, "match": ["Code"],
    "required": ["Code", "Description", "AssetBalanceSheetAccount"], "requires": ["Chart of Accounts"],
    "accounts": ["AssetBalanceSheetAccount", "ClearingAccountAcquisition", "OrdinaryDepreciation", "AccumulatedOrdinaryDepr", "UnplannedDepreciation",
      "AccumulatedUnplannedDepr", "SpecialDepreciation", "AccumulatedSpecialDepr", "RevaluationReserveAccount", "RevaluationReserveClearing",
      "RevaluationAccount", "RevenuefromAssetSalesNet", "RetirementwithExpenseNet", "RetirementwithRevenueNet", "LeavewithExpenseNBVGross",
      "LeavewithRevenueNBVGross", "RevenueAccountforRetirement", "RevenueClearingAccount"] },
  { "id": "asset-classes", "tier": "D", "kind": "data", "title": "Asset Class", "doc": "fixed-asset", "ref": "2.13", "template": "T15",
    "entity": "AssetClasses", "keyField": "Code", "keyString": true, "match": ["Code"], "required": ["Code", "Description", "_Branch"],
    "requires": ["FA Account Determination", "Branch"],
    "lookups": [{ "field": "BPLID", "from": "_Branch", "step": "branches", "by": "Name" }],
    "note": "Header saja; depreciation area per kelas (ACS1) belum ikut di-upload. Branch dicocokkan lewat nama." },

  { "id": "items", "tier": "E", "kind": "data", "title": "Item", "doc": "items", "ref": "3.2", "template": "T06",
    "entity": "Items", "keyField": "ItemCode", "keyString": true, "match": ["ItemCode"], "required": ["ItemCode", "ItemName"],
    "numeric": ["PurchaseItemsPerUnit", "SalesItemsPerUnit"], "requires": ["Item Group", "UoM Groups", "Tax Group", "Warehouse", "Price List"],
    "lookups": [{ "field": "ItemsGroupCode", "from": "_ItemGroup", "step": "item-groups", "by": "GroupName" }],
    "note": "Header saja; UDF, harga per price list, dan data per gudang belum ikut di-upload." },
  { "id": "business-partners", "tier": "E", "kind": "data", "title": "Business Partner", "doc": "business-partners", "ref": "3.4", "template": "T11",
    "entity": "BusinessPartners", "keyField": "CardCode", "keyString": true, "match": ["CardCode"], "required": ["CardCode", "CardName", "CardType"],
    "numeric": ["CreditLimit"],
    "requires": ["Business Partner Group", "Payment Terms", "Price List", "Sales Employee / Buyer", "Shipping Type", "Chart of Accounts", "Branch"],
    "lookups": [
      { "field": "GroupCode", "from": "_BPGroup", "step": "bp-groups", "by": "Name" },
      { "field": "PayTermsGrpCode", "from": "_PaymentTerms", "step": "payment-terms", "by": "PaymentTermsGroupName" },
      { "field": "PriceListNum", "from": "_PriceList", "step": "price-lists", "by": "PriceListName" },
      { "field": "SalesPersonCode", "from": "_SalesEmployee", "step": "sales-employees", "by": "SalesEmployeeName" }],
    "note": "Header saja; alamat, contact person, dan branch assignment belum ikut di-upload." },
  { "id": "fixed-assets", "tier": "E", "kind": "data", "title": "Fixed Asset Master Data", "doc": "fixed-asset", "ref": "2.13",
    "entity": "Items", "keyField": "ItemCode", "keyString": true, "match": ["ItemCode"], "required": ["ItemCode", "ItemName", "AssetClass"],
    "requires": ["Asset Class", "Item Group"],
    "lookups": [{ "field": "ItemsGroupCode", "from": "_ItemGroup", "step": "item-groups", "by": "GroupName" }],
    "note": "Item tipe Fixed Asset. Belum ada template Excel tersendiri." },
  { "id": "document-numbering", "tier": "E", "kind": "data", "title": "Document Numbering", "doc": "document-numbering", "ref": "1.9",
    "entity": "SeriesService", "action": { "create": "SeriesService_AddSeries", "update": "SeriesService_UpdateSeries", "wrap": "Series" },
    "keyField": "Series", "match": ["Document", "DocumentSubType", "Name"], "required": ["Document", "Name", "PeriodIndicator"],
    "numeric": ["InitialNumber", "LastNumber"], "alwaysSend": ["Document", "DocumentSubType"], "requires": ["Branch", "Posting Period"],
    "lookups": [{ "field": "BPLID", "from": "_Branch", "step": "branches", "by": "Name" }],
    "note": "Lewat aksi SeriesService_AddSeries (baru) dan SeriesService_UpdateSeries (ubah), bukan entity. Belum ada template Excel." },

  { "id": "branches", "kind": "ref", "title": "Branch (referensi)", "match": ["Name"] },
  { "id": "dimensions", "kind": "ref", "title": "Dimension (referensi)", "match": ["Name"] }
]
