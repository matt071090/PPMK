# Tambah payment terms (OCTG) lewat Service Layer. Urut 1 -> 2 -> 3 -> 4.
# Field lain (Due date based on, Start from) dibiarkan default SAP. Satu changeset: kalau satu gagal, semua batal.

@sl = https://192.168.40.197:50000/b1s/v1

### 1. Login
POST {{sl}}/Login
Content-Type: application/json

{"CompanyDB":"CVPPM","UserName":"manager","Password":"1234"}

### 2. Tambah 22 payment terms (hasil benar: 22x "HTTP/1.1 201 Created")
POST {{sl}}/$batch
Content-Type: multipart/mixed;boundary=batch_pt

--batch_pt
Content-Type: multipart/mixed;boundary=changeset_pt

--changeset_pt
Content-Type: application/http
Content-Transfer-Encoding: binary

POST /b1s/v1/PaymentTermsTypes
Content-Type: application/json

{"PaymentTermsGroupName":"Cash After Delivery","NumberOfAdditionalDays":0}

--changeset_pt
Content-Type: application/http
Content-Transfer-Encoding: binary

POST /b1s/v1/PaymentTermsTypes
Content-Type: application/json

{"PaymentTermsGroupName":"Cash Before Delivery","NumberOfAdditionalDays":0}

--changeset_pt
Content-Type: application/http
Content-Transfer-Encoding: binary

POST /b1s/v1/PaymentTermsTypes
Content-Type: application/json

{"PaymentTermsGroupName":"Cash On Delivery","NumberOfAdditionalDays":0}

