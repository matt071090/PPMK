<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 2.7.x: versi Spring Boot terakhir yang masih jalan di Java 8 (server target masih Java 8) -->
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.stem</groupId>
    <artifactId>cvppmk-docs</artifactId>
    <version>0.1.0</version>
    <!-- war: taruh target/cvppmk.war di webapps Tomcat 9 -> http://<server>:<port>/cvppmk/ -->
    <packaging>war</packaging>
    <name>cvppmk-docs</name>
    <description>Dokumentasi project CVPPMK, data langsung dari SAP B1</description>

    <properties>
        <java.version>1.8</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sap.cloud.db.jdbc</groupId>
            <artifactId>ngdbc</artifactId>
            <version>2.28.6</version>
        </dependency>
        <!-- SSH ke server HANA untuk Backup & Restore (tidak butuh klien ssh di komputer / server Tomcat) -->
        <dependency>
            <groupId>com.github.mwiede</groupId>
            <artifactId>jsch</artifactId>
            <version>0.2.18</version>
        </dependency>
        <!-- disediakan Tomcat di server; tetap dipakai saat dijalankan dari VS Code / java -jar -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <finalName>cvppmk</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Dibundel ke war supaya cukup satu file di webapps:
                 ./application.properties (koneksi DB & SL, tidak di-commit) -> classpath:config/, prioritasnya di atas application.properties bawaan;
                 ./review.json (hasil review mode edit) -> dibaca read-only di server. -->
            <resource>
                <directory>${project.basedir}</directory>
                <includes><include>application.properties</include></includes>
                <targetPath>config</targetPath>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <includes><include>review.json</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- War = web dokumentasi saja: halaman Setup & Cut Off beserta query-nya tidak ikut dibundel.
                 Tetap tersedia saat dijalankan dari VS Code (mode dev). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <packagingExcludes>WEB-INF/classes/static/setup.html,WEB-INF/classes/static/js/pages/setup.js,WEB-INF/classes/setup/**</packagingExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
