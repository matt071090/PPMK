{
    // Jalankan lewat Terminal > Run Task... (atau Ctrl+Shift+P > "Tasks: Run Task").
    // Selalu pakai JDK 8 supaya class di target/ bisa jalan di server Java 8.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CVPPMK: mvnw clean compile (JDK 8)",
            "detail": "Hapus target/ lalu compile ulang dengan JDK 8. Pakai kalau muncul UnsupportedClassVersionError.",
            "type": "shell",
            "command": ".\\mvnw.cmd",
            "args": ["-o", "clean", "compile"],
            "options": {
                "cwd": "${workspaceFolder}/CVPPMK",
                "env": { "JAVA_HOME": "C:\\Program Files\\Java\\jdk1.8.0_503" }
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "CVPPMK: build war (JDK 8)",
            "detail": "Hasil: CVPPMK/target/cvppmk.war, siap ditaruh di webapps Tomcat 9.",
            "type": "shell",
            "command": ".\\mvnw.cmd",
            "args": ["-o", "clean", "package", "-DskipTests"],
            "options": {
                "cwd": "${workspaceFolder}/CVPPMK",
                "env": { "JAVA_HOME": "C:\\Program Files\\Java\\jdk1.8.0_503" }
            },
            "problemMatcher": [],
            "group": "build"
        }
    ]
}
